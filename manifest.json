{
  "manifest_version": 3,
  "name": "ChatGPT → 飞书 · 公式图片复制",
  "version": "1.2.1",
  "description": "增强 ChatGPT 复制并导出当前会话为离线 HTML，保留飞书兼容的公式、表格、图片和图表。",
  "homepage_url": "https://github.com/YijiaQian/chatgpt-feishu-copy",
  "minimum_chrome_version": "116",
  "permissions": ["clipboardWrite", "storage", "offscreen", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://*.oaiusercontent.com/*", "https://*.oaistatic.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "ChatGPT → 飞书"},
  "options_page": "converter.html",
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "run_at": "document_start",
    "js": ["vendor/markdown-it.min.js", "vendor/purify.min.js", "vendor/html2canvas.min.js", "charts.js", "core.js", "conversation.js", "archive.js", "content.js"]
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data: blob: https:; font-src 'self'; style-src 'self' 'unsafe-inline'; connect-src https: data: blob:;"}
}
